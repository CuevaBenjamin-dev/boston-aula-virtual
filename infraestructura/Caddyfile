:80 {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api-aula:8080
  }
  handle /oauth2/* {
    reverse_proxy api-aula:8080
  }
  handle /login/* {
    reverse_proxy api-aula:8080
  }
  handle /logout {
    reverse_proxy api-aula:8080
  }
  handle /actuator/* {
    reverse_proxy api-aula:8080
  }
  handle {
    reverse_proxy frontend:80
  }
}

